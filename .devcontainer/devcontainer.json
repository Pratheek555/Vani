{
  "name": "Vani development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "mounts": [
    "source=vani-data,target=/data,type=volume"
  ],
  "forwardPorts": [3000, 8787],
  "portsAttributes": {
    "3000": {
      "label": "Vani web",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8787": {
      "label": "Vani gateway",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8788": {
      "label": "Vani core, local only",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
