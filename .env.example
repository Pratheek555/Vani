# ---- gateway ----
PUBLIC_URL=http://localhost:8787
DATA_DIR=./.data
TELEGRAM_BOT_USERNAME=VaniFamilyBot
# Shared with Keiki: signs identity + tool webhooks (X-Keiki-Signature)
KEIKI_WEBHOOK_SECRET=change-me-to-a-long-random-string
LOG_KEIKI_PAYLOADS=1
# local = one core process on this machine, one SQLite file per family
# maritime = one Maritime agent (VM) per family
CORE_RUNTIME=local
LOCAL_CORE_URL=http://127.0.0.1:8788
MARITIME_API_KEY=
CORE_IMAGE=
CORE_TEMPLATE=custom

# ---- keiki sync ----
KEIKI_API_KEY=
KEIKI_MODEL=

# ---- core (local dev) ----
CORE_PORT=8788

# ---- web (apps/web reads its own environment; these defaults suit local dev) ----
# Where /login, /signup, /app and /api/* are proxied to
GATEWAY_URL=http://localhost:8787
# Public URL of the website, for link previews
SITE_URL=http://localhost:3000
