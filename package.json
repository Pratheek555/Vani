{
  "name": "vani",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:gateway": "tsx watch apps/gateway/src/index.ts",
    "dev:core": "tsx watch apps/core/src/index.ts",
    "dev:web": "pnpm --filter @vani/web dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "db:generate": "drizzle-kit generate --config apps/gateway/drizzle.config.ts && drizzle-kit generate --config apps/core/drizzle.config.ts",
    "keiki:print": "tsx keiki/sync.ts --print",
    "keiki:sync": "tsx keiki/sync.ts",
    "sim": "tsx scripts/keiki-sim.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@onkeiki/agents": "^0.1.4",
    "@vani/shared": "workspace:*",
    "zod": "^4.6.7"
  }
}
